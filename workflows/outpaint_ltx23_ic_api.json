{
  "_meta": {
    "title": "LTX-2.3 IC-LoRA Outpaint (oumoumad) — API format, machine-validated",
    "description": "Validated against ComfyUI 0.20.1 with base-directory E:/Documents/ComfyUI. Bypasses the 5 custom nodes the author's PDF assumes (CM_FloatToInt, Switch image [Crystools] x2, Color Correct (mtb) x2). Ready to enqueue via /prompt or mcp__comfyui__enqueue_workflow.",
    "source": "https://huggingface.co/oumoumad/LTX-2.3-22b-IC-LoRA-Outpaint",
    "diffs_vs_author": [
      "ckpt_name uses bare filename (no LTX-2\\ prefix) — local checkpoints/ folder has no subfolder",
      "lora_name 4922 set to ltx-2.3-22b-distilled-1.1_lora-dynamic_fro09_avg_rank_111_bf16.safetensors (the distilled LoRA actually present locally)",
      "lora_name 5011 set to ltx-2.3-22b-ic-lora-outpaint.safetensors (downloaded to models/loras/)",
      "text_encoder set to gemma_3_12B_it_fp4_mixed.safetensors (the local Gemma flavour)",
      "5012.image rewired from missing 5087 (Switch image) → 5085 directly (gamma=false branch)",
      "5067.image1 rewired from missing 5089 (Switch image) → 4851 (decoded video)",
      "5076.images rewired same as above",
      "3980.frame_rate set to literal 24 (replaces missing CM_FloatToInt cast)",
      "ResizeImageMaskNode widget keys use the dynamic-combo schema (resize_type.* prefix) per ComfyUI 0.18+"
    ],
    "models_required": [
      "checkpoints/ltx-2.3-22b-dev-fp8.safetensors",
      "loras/ltx-2.3-22b-distilled-1.1_lora-dynamic_fro09_avg_rank_111_bf16.safetensors",
      "loras/ltx-2.3-22b-ic-lora-outpaint.safetensors",
      "text_encoders/gemma_3_12B_it_fp4_mixed.safetensors"
    ],
    "customize": {
      "video":      "Node 5060.video — set to your input clip filename (must live in ComfyUI/input/)",
      "image_stub": "Node 2004.image — first-frame PNG of the clip (any image works since bypass_i2v=true; matching aspect avoids ugly resize work)",
      "prompt":     "Node 2483.text — positive prompt that describes the SCENE BEING OUTPAINTED (the LoRA fills black-padded regions with content matching this)",
      "seed":       "Node 4832.noise_seed — change for different fills",
      "pad":        "Node 5086 (ImagePadKJ) — controls canvas extension. Output dims ≈ ((source + pads) ÷ 2) snapped to /32. Defaults below assume a 1080×1920 (9:16) source padded to ~16:9.",
      "presets": {
        "9_16_to_16_9_vertical_to_horizontal": { "left": 1166, "right": 1166, "top": 0, "bottom": 0, "expected_output": "1696×960 (≈16:9)" },
        "16_9_to_9_16_horizontal_to_vertical": { "left": 0, "right": 0, "top": 1166, "bottom": 1166, "expected_output": "960×1696 (≈9:16)" },
        "horizontal_only_widening_16_9_to_2_35_1": { "left": 480, "right": 480, "top": 0, "bottom": 0, "expected_output": "1440×544 (≈2.65:1)" }
      }
    },
    "frame_count_quirk": "LTX 2.3 only generates lengths of 8k+1 frames (1, 9, 17, 25, 33, 41, 49, 57, 65, …). Source clips with other counts get truncated DOWN to the nearest valid count. To preserve the full clip, pre-pad with freeze frames using ffmpeg (`-vf tpad=stop_mode=clone:stop_duration=Xs`) before sending, then trim the extra frames after."
  },
